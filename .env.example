# iDos Games title (canonical, prod). The game resolves it from {id}.idos.games automatically when hosted.
VITE_IDOS_TITLE_ID=JE8W0Z54
# "prod" | "dev" (dev = JE8W0Z54-DEV copy of the title)
VITE_IDOS_ENV=prod
# Solana devnet RPC for opt-in on-chain records (memo transactions)
VITE_SOLANA_DEVNET_RPC=https://api.devnet.solana.com
# Mainnet RPC used read-only to show the $SHAI token balance
VITE_SOLANA_MAINNET_RPC=https://solana-rpc.publicnode.com
